```gitignore
# Virtual Environment
.venv/
venv/

# Environment Variables / Secrets
.env
.env.*
!.env.example

# Python Cache
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Build / Packaging
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/

# IDEs
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db

# Coverage
.coverage
.coverage.*
htmlcov/

# Logs
*.log
logs/

# Local database / temporary files
*.sqlite
*.sqlite3
```
